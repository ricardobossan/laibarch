#!/bin/bash
# YouTube search and play in mpv with thumbnails

CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/yts/thumbs"

# kitty/foot draw real pixels, so detail scales with the pane's pixel size. alacritty
# has no graphics protocol; its symbol art is capped by cell count and turns to mush in
# a small window. Override with YTS_FORMAT=kitty|sixels|symbols.
detect_format() {
    if [ -n "${YTS_FORMAT:-}" ]; then printf '%s' "$YTS_FORMAT"; return; fi
    case "${TERM:-}|${TERM_PROGRAM:-}|${KITTY_WINDOW_ID:+kitty}" in
        *kitty*) printf 'kitty' ;;
        *foot*)  printf 'sixels' ;;
        *)       printf 'symbols' ;;
    esac
}

# Preview mode: fzf re-invokes this per highlighted row. Thumbnails load on demand, so
# the result count costs nothing up front, and are cached across runs.
if [ "$1" = "--__preview" ]; then
    id="$2"
    f="$CACHE/$id.jpg"
    mkdir -p "$CACHE"
    # maxres (1280x720) is missing on ~1 in 20 videos; mq (320x180) is the fallback.
    # Not hq/sd: they are 4:3 and letterbox 16:9. Test -s, not -f -- curl -f can leave
    # a 0-byte file on 404 and poison the cache.
    [ -s "$f" ] || curl -sf -o "$f" "https://i.ytimg.com/vi/$id/maxresdefault.jpg"
    [ -s "$f" ] || curl -sf -o "$f" "https://i.ytimg.com/vi/$id/mqdefault.jpg"
    [ -s "$f" ] || { rm -f "$f"; echo "(no thumbnail)"; exit 0; }
    fmt=$(detect_format)
    cols=${FZF_PREVIEW_COLUMNS:-80}
    lines=${FZF_PREVIEW_LINES:-40}

    # Graphics codes need explicit wrapping to survive a multiplexer.
    pass=none
    [ -n "${TMUX:-}" ] && pass=tmux
    [ -n "${STY:-}" ] && pass=screen

    case "$fmt" in
    kitty)
        # Recipe from /usr/share/fzf/fzf-preview.sh: raw kitty graphics do not survive
        # fzf's redraw, but unicode placeholders anchor the image to cells so fzf can
        # manage it. Its trailing reset lacks a newline and fzf reads that as a scroll
        # offset, hence the seds.
        if command -v kitten >/dev/null 2>&1; then
            # icat emits nothing when it cannot reach a real kitty. Buffer so that is
            # detectable (and binary-safe) and we degrade to art instead of a blank pane.
            raw=$(mktemp)
            kitten icat --clear --transfer-mode=memory --unicode-placeholder \
                --stdin=no --place="${cols}x${lines}@0x0" "$f" >"$raw" 2>/dev/null
            if [ -s "$raw" ]; then
                sed '$d' "$raw" | sed $'$s/$/\e[m/'
                rm -f "$raw"
                exit 0
            fi
            rm -f "$raw"
        fi
        exec chafa -f symbols -s "${cols}x${lines}" \
            -w 9 --colors full --color-space din99d "$f"
        ;;
    sixels)
        # Sixel touching the last row scrolls the pane (fzf#2544); give a line back.
        [ "$((${FZF_PREVIEW_TOP:-0} + lines))" -ge "$(tput lines 2>/dev/null || echo 999)" ] \
            && lines=$((lines - 1))
        chafa -f sixels --passthrough "$pass" -s "${cols}x${lines}" \
            -w 9 --colors full --color-space din99d "$f"
        echo
        ;;
    *)
        exec chafa -f symbols -s "${cols}x${lines}" \
            -w 9 --colors full --color-space din99d "$f"
        ;;
    esac
fi

COUNT="${YTS_COUNT:-50}"

while [ $# -gt 0 ]; do
    case "$1" in
        -n)  COUNT="$2"; shift 2 ;;
        -n*) COUNT="${1#-n}"; shift ;;
        --)  shift; break ;;
        -*)  echo "Usage: yts [-n COUNT] <search query>" >&2; exit 1 ;;
        *)   break ;;
    esac
done

if [ $# -eq 0 ]; then
    echo "Usage: yts [-n COUNT] <search query>" >&2
    exit 1
fi

mkdir -p "$CACHE"

SELF=$(readlink -f "$0")

# alacritty cannot draw images, so hop into kitty just for the picker rather than
# changing the default terminal. Guards: no recursion, no hijacking a pipe or script,
# no overriding an explicit YTS_FORMAT, and only if kitty exists.
if [ -z "${YTS_SPAWNED:-}" ] && [ -z "${YTS_NO_SPAWN:-}" ] && [ -z "${YTS_FORMAT:-}" ] \
   && [ -t 1 ] && [ "$(detect_format)" = "symbols" ] && command -v kitty >/dev/null 2>&1; then
    echo "This terminal can't draw images; opening kitty for real thumbnails." >&2
    echo "(YTS_NO_SPAWN=1 to stay here with symbol art.)" >&2
    # </dev/null: setsid detaches the session, but an inherited pty on fd 0 still earns
    # a SIGHUP. -u TMUX: the new window is not inside tmux, yet would inherit the var and
    # wrap its graphics in passthrough sequences nothing unwraps -- invisible images.
    YTS_SPAWNED=1 setsid env -u TMUX -u TMUX_PANE -u STY \
        kitty -e "$SELF" -n "$COUNT" -- "$@" </dev/null >/dev/null 2>&1 &
    exit 0
fi

LIST=$(mktemp)
trap 'rm -f "$LIST"' EXIT

echo "Searching YouTube for '$*' ($COUNT results)..." >&2

# --print with real tabs: --get-title/--get-id piped through `paste - -` desyncs titles
# from IDs whenever a title contains a newline.
yt-dlp "ytsearch$COUNT:$*" \
    --no-playlist \
    --extractor-args "youtube:player_client=default" \
    --flat-playlist \
    --print $'%(id)s\t%(title)s\t%(channel)s\t%(duration)s\t%(view_count)s' \
    2>/dev/null | \
python3 -c '
import sys, unicodedata

# Pad by display width, not character count: emoji and CJK occupy two columns, so
# counting characters (as awk does) leaves the columns ragged.
def cw(ch):
    if ch in "\ufe0f\ufe0e" or unicodedata.category(ch) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1

def fit(s, n):
    out, w = [], 0
    for ch in s:
        c = cw(ch)
        if w + c > n:
            break
        out.append(ch)
        w += c
    return "".join(out) + " " * (n - w)

def hms(s):
    try:
        s = int(float(s))
    except ValueError:
        return "--:--"
    if s <= 0:
        return "--:--"
    h, m, r = s // 3600, (s % 3600) // 60, s % 60
    return "%d:%02d:%02d" % (h, m, r) if h else "%d:%02d" % (m, r)

def views(v):
    try:
        v = int(float(v))
    except ValueError:
        return "-"
    if v <= 0:
        return "-"
    if v >= 1000000:
        return "%.1fM" % (v / 1000000.0)
    if v >= 1000:
        return "%.1fK" % (v / 1000.0)
    return str(v)

for line in sys.stdin:
    p = line.rstrip("\n").split("\t")
    if len(p) < 5:
        continue
    sys.stdout.write("%s\t%s  %s  %8s  %8s\n"
                     % (p[0], fit(p[1], 70), fit(p[2], 18), hms(p[3]), views(p[4])))
' > "$LIST"

if [ ! -s "$LIST" ]; then
    echo "No results." >&2
    exit 1
fi

selected=$(fzf --delimiter='\t' \
        --with-nth=2.. \
        --preview="$SELF --__preview {1}" \
        --preview-window=up:70% \
        --prompt="Select video: " \
        --height=100% \
        --reverse < "$LIST" | cut -f1)

# YouTube demands auth for full format extraction; without it mpv's ytdl_hook dies on
# "Sign in to confirm you're not a bot". Search is unaffected -- --flat-playlist only
# reads metadata. Browser cookies clear it. Set YTS_COOKIES_BROWSER= (empty) to disable.
COOKIES="${YTS_COOKIES_BROWSER-brave}"

# YouTube binds media URLs to the yt-dlp session that requested them (PO tokens), so
# handing them to mpv's ytdl_hook gets a 403 from ffmpeg -- every player_client either
# fails extraction or yields unfetchable URLs. So yt-dlp fetches and we pipe into mpv.
# Merging bv+ba into mkv on the way keeps full resolution: muxed formats (-f b) stop at
# 1080p, so 4K would be lost. A pipe still cannot be seeked; a PO-token provider (AUR
# bgutil-ytdlp-pot-provider) would let mpv take the URLs directly and restore seeking.
# Cap resolution with YTS_MAX_HEIGHT=1080 if 4K AV1 decoding is too heavy.
if [ -n "$selected" ]; then
    vurl="https://youtube.com/watch?v=$selected"
    # Cap to the tallest connected display: fetching 4K for a 1440p screen just burns
    # bandwidth and AV1 decode to be downscaled. YTS_MAX_HEIGHT overrides; set it empty
    # to lift the cap entirely.
    height="${YTS_MAX_HEIGHT-$(wlr-randr 2>/dev/null \
        | grep -oP '^\s+\d+x\K\d+(?= px.*current)' | sort -rn | head -1)}"
    fmt="bv*+ba/b"
    [ -n "$height" ] && fmt="bv*[height<=$height]+ba/b"
    # Quitting mpv early tears down the pipe; drop the resulting mux/pipe noise so real
    # errors (expired cookies, bot check) still surface.
    quiet() { grep -viE "broken pipe|error muxing|ffmpeg exited with code" >&2; }
    if [ -n "$COOKIES" ]; then
        yt-dlp -f "$fmt" --merge-output-format mkv --cookies-from-browser "$COOKIES" \
            -o - "$vurl" 2> >(quiet) | mpv --cache=yes -
    else
        yt-dlp -f "$fmt" --merge-output-format mkv -o - "$vurl" 2> >(quiet) | mpv --cache=yes -
    fi
fi
